# Update the CSV integration/chat over the current production dependencies/pooling.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
COPY main.py integration_tourism.py chat_recommendations.py /app/
COPY tests/ /app/tests/
COPY docs/smart-era-integration.md /app/docs/smart-era-integration.md
COPY README.md /app/README.md
RUN rm -f /app/data/integration_pois.json
